{
  "manifest_version": 3,
  "name": "umbilical",
  "description": "Send a link to the umbilical download manager. Only the URL and an optional file name are sent.",
  "version": "0.0.1",
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "action": {
    "default_title": "umbilical",
    "default_popup": "popup.html"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage"
  ]
}
