{
  "manifest_version": 3,
  "name": "umbilical",
  "description": "Send a link to the umbilical download manager. Only the URL and an optional file name are sent.",
  "version": "1.0.2",
  "background": {
    "scripts": ["website-access.js", "background.js"],
    "persistent": false
  },
  "action": {
    "default_title": "umbilical",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
